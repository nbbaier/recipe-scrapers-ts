{
  "name": "recipe-scrapers-ts",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript port of recipe-scrapers - Extract recipe data from cooking websites",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "build:quiet": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap --silent",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "check": "bun run type-check && bun run lint && bun run test",
    "test:scrapers": "bun run build:quiet && bun scripts/test-scrapers.ts",
    "validate-parity": "bun run build:quiet && bun scripts/validate-parity.ts",
    "validate-registry": "bun scripts/validate-scraper-registry.ts",
    "sync-registry": "bun scripts/sync-scraper-registry.ts",
    "compare": "bun scripts/compare-outputs.ts",
    "sync-test-data": "bash scripts/sync-test-data.sh",
    "dashboard": "bun scripts/generate-dashboard.ts",
    "migration:batch": "bun scripts/migration-batch.ts",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "migrate": "bun scripts/migrate-scraper.ts"
  },
  "keywords": [
    "recipe",
    "scraper",
    "parser",
    "cooking",
    "schema.org",
    "structured-data",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbbaier/recipe-scrapers-ts.git"
  },
  "bugs": {
    "url": "https://github.com/nbbaier/recipe-scrapers-ts/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jsonld": "^9.0.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/bun": "^1.3.11",
    "@types/cheerio": "^1.0.0",
    "@types/diff": "^8.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "chalk": "^5.6.2",
    "diff": "^8.0.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
